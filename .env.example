# Redis (agents' working memory)
REDIS_URL=redis://localhost:6379/0

# MongoDB results store (collections: runs, records)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=network_slicing_poc

# Working-memory configuration
MEMORY_TTL_SECONDS=3600
MEMORY_MAX_RECORDS=10
# API keys and tokens for various services
HF_TOKEN=
GROK_API_KEY=
GEMINI_API_KEY=

OPEN_ROUTER_API_KEY=
#LiteLLM configuration
LITELLM_MASTER_KEY=sk-change-me

LITELLM_API_BASE=http://localhost:4000

LITELLM_API_KEY=sk-your-litellm-virtual-key
# The RIC agents also reach their MCP tool servers through LiteLLM, with the
# same key: ${LITELLM_API_BASE}/near_rt/mcp and /non_rt/mcp (litellm_config.yaml).
# Separator LiteLLM puts between server and tool names (its default is "-").
# MCP_TOOL_PREFIX_SEPARATOR=-

MODEL_NAME=nvidia-network-slicing-model

# Model calls: the LiteLLM gateway retries and falls back to other models
# (litellm_config.yaml, router_settings), so the client makes one attempt.
# When every model of the chain is rate-limited, the run stops.
# Request budget shared by every agent (0 = unlimited; OpenRouter free models
# allow about 20 per minute).
LLM_MAX_RETRIES=1
LLM_REQUESTS_PER_MINUTE=20
# Governance LLM review timeout, retries and waits included (fail closed).
GOVERNANCE_LLM_TIMEOUT_S=180

# LangSmith tracing: one trace per record (agents/record_workflow.py)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=network-slicing-poc
# Optional: address the traces by agent (needs langsmith>=0.14.9)
# LANGSMITH_AGENT_ID=network-slicing-poc
# LANGSMITH_AGENT_ENVIRONMENT=local

DATABASE_URL=postgresql://litellm:<password>@localhost:5433/litellm

# Governance (v3)
NON_RT_MIN_PERSISTENCE=3
MAX_PROTECTED_CALLS_PER_INVOCATION=20
